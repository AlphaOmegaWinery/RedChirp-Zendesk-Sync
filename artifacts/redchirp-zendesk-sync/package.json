{
  "name": "redchirp-zendesk-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two-way sync between RedChirp texting and Zendesk messaging for Alpha Omega",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify:baseline": "tsx scripts/verify-baseline.ts",
    "staff:sync": "tsx scripts/sync-staff.ts",
    "phones:validate": "tsx scripts/validate-phone-map.ts",
    "migrate": "tsx src/db/migrate.ts",
    "setup:integration": "tsx scripts/setup-integration.ts",
    "spike:messaging": "tsx scripts/spike-messaging.ts",
    "spike:ticket": "tsx scripts/spike-ticket.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
